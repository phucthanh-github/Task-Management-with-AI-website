# Application Environment: development | test | production
APP_ENV=development

# MongoDB Connection Configuration
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=todolist_db

# Security & JWT Auth
# Generate strong key in production: openssl rand -hex 32
SECRET_KEY=dev_only_secret_key_must_change_in_production_environment_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Hugging Face Configuration (For Chatbot Agent)
HF_TOKEN=your_hugging_face_api_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Email Notification Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Sign-in Credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Local Development Demo Auth Flag (Set false in production)
DEV_DEMO_ENABLED=false

# Rate Limiting Configuration
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CHAT=20/minute
